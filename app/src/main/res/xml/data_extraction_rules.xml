<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (Auto Backup to Google Drive and device-to-device transfer).
     Only files/autobackup/ is included: a key-free JSON copy of settings and conversations that the app
     writes itself. Everything else is left out on purpose: the Keystore-bound encrypted preferences
     (they cannot be decrypted on another install and would crash it), downloaded model files (GBs),
     caches, per-conversation workspaces and audit logs. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="autobackup" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="autobackup" />
    </device-transfer>
</data-extraction-rules>
